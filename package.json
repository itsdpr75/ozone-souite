{
  "name": "ozone-souite",
  "version": "1.0.0",
  "description": "Sistema de gestion empresarial para fotogrametria y activos 3D",
  "author": "Ozone Souite <ozone-souite@example.com>",
  "homepage": "https://github.com/ozone-souite",
  "main": "main.js",
  "scripts": {
    "start": "ELECTRON_OZONE_PLATFORM=x11 electron .",
    "start:x11": "ELECTRON_OZONE_PLATFORM=x11 electron .",
    "build": "bash scripts/build.sh --linux",
    "build:appimage": "bash scripts/build.sh --linux AppImage",
    "build:deb": "bash scripts/build.sh --linux deb",
    "build:rpm": "bash scripts/build.sh --linux rpm",
    "build:pacman": "bash scripts/build.sh --linux pacman",
    "build:all": "bash scripts/build.sh"
  },
  "build": {
    "appId": "com.ozone-souite.app",
    "productName": "Ozone Souite",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!node_modules/.pnpm/**"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "pacman",
        "dir"
      ],
      "icon": "assets/icon.png",
      "category": "Office"
    }
  },
  "dependencies": {
    "sql.js": "^1.12.0",
    "archiver": "^7.0.1",
    "unzipper": "^0.12.3",
    "csv-stringify": "^6.5.2",
    "csv-parse": "^5.6.0",
    "balanced-match": "^1.0.2"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.8.1"
  }
}
